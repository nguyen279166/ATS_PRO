DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_SECRET="replace_with_a_long_random_secret"
BASE_URL=http://localhost:3001
CLIENT_URL=http://localhost:5173

# Optional, only needed for email features.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Optional, only needed for cloud CV storage.
# Without these, the server falls back to local uploads in server/uploads/cv.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_CV_FOLDER="ats-pro/cv"
CLOUDINARY_AVATAR_FOLDER="ats-pro/avatars"

# Optional, only needed for CV AI/RAG features.
# Local/free default: Ollama. Run `ollama serve`, then pull the models below.
RAG_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_CHAT_MODEL="llama3.2:3b"

# Optional cloud fallback: Gemini API.
GEMINI_API_KEY=""
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"
GEMINI_CHAT_MODEL="gemini-2.5-flash-lite"
