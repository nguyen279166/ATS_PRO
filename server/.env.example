DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_SECRET="replace_with_a_long_random_secret"
BASE_URL=http://localhost:3001
CLIENT_URL=http://localhost:5173

# Optional, only needed for email features.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Optional, only needed for cloud CV storage.
# Without these, the server falls back to local uploads in server/uploads/cv.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_CV_FOLDER="ats-pro/cv"
CLOUDINARY_AVATAR_FOLDER="ats-pro/avatars"

# Optional, only needed for CV AI/RAG features.
# Gemini API has a free tier for demos and portfolio projects.
GEMINI_API_KEY=""
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"
GEMINI_CHAT_MODEL="gemini-2.5-flash-lite"
