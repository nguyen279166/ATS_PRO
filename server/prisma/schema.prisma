generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================
// 🏢 BẢNG USER - Lưu thông tin HR / Admin
// =============================================
model User {
  id        String   @id @default(uuid())    // Mã định danh duy nhất, tự động sinh
  email     String   @unique                 // Email không được trùng
  password  String                           // Mật khẩu (sẽ được mã hoá)
  fullName  String
  avatar    String?                          // 👈 Thêm trường ảnh đại diện (có thể null)
  role      String   @default("hr")          // Vai trò: "hr" hoặc "admin"
  createdAt DateTime @default(now())         // Ngày tạo: Tự động lấy thời điểm hiện tại

  jobs      Job[]        // 👈 1 User quản lý NHIỀU Job
  notes     Note[]       // 👈 1 User viết NHIỀU Note
  interviews Interview[] // 👈 1 User tạo NHIỀU lịch phỏng vấn
}

// =============================================
// 💼 BẢNG JOB - Tin tuyển dụng
// =============================================
model Job {
  id         String   @id @default(uuid())
  title      String                          // "Frontend Developer"
  department String                          // "Engineering"
  location   String                          // "Remote"
  description String?  @db.Text
  status     String   @default("Open")       // "Open" hoặc "Closed"
  createdAt  DateTime @default(now())

  // 👈 MỐI QUAN HỆ: Job này thuộc về User nào (HR nào tạo)
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  candidates Candidate[]  // 👈 1 Job có NHIỀU Candidate
}

// =============================================
// 👤 BẢNG CANDIDATE - Ứng viên
// =============================================
model Candidate {
  id          String   @id @default(uuid())
  name        String
  email       String
  status      String   @default("Applied")   // "Applied" | "Interviewing" | "Hired" | "Rejected"
  appliedDate DateTime @default(now())
  avatar      String?                        // Dấu ? = CÓ THỂ TRỐNG (optional)

  // 👈 MỐI QUAN HỆ: Candidate này ứng tuyển vào Job nào
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  notes       Note[]       // 👈 1 Candidate có NHIỀU Note
  interviews  Interview[]  // 👈 1 Candidate có NHIỀU buổi phỏng vấn
}

// =============================================
// 📝 BẢNG NOTE - Ghi chú của HR về ứng viên
// =============================================
model Note {
  id          String    @id @default(uuid())
  content     String    @db.Text               // Nội dung ghi chú (dài)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt             // Tự động cập nhật khi sửa

  // 👈 Ghi chú này thuộc về Candidate nào
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // 👈 Ghi chú này do HR nào viết
  userId      String
  user        User      @relation(fields: [userId], references: [id])
}

// =============================================
// 📅 BẢNG INTERVIEW - Lịch phỏng vấn
// =============================================
model Interview {
  id          String   @id @default(uuid())
  scheduledAt DateTime                          // Ngày giờ phỏng vấn
  location    String?                           // Địa điểm hoặc link Meet/Zoom
  notes       String?  @db.Text                // Ghi chú thêm về buổi PV
  status      String   @default("Scheduled")   // "Scheduled" | "Done" | "Cancelled"
  createdAt   DateTime @default(now())

  // 👈 Buổi phỏng vấn này dành cho Candidate nào
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // 👈 Do HR nào tạo
  createdBy   String
  creator     User      @relation(fields: [createdBy], references: [id])
}
